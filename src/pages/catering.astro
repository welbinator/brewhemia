---
import Base from "../layouts/Base.astro";
---

<Base
  title="Catering"
  description="Brewhemia catering for your office or event in the Cedar Rapids area — coffee, breakfast & lunch. Call or text Andrea at 319-389-3595 to get started."
  bannerTitle="Catering"
  bannerKicker="For your office or event"
  bannerImage="/images/brewhemia_catering.webp"
>
  <section class="catering">
    <div class="catering-intro">
      <span class="mono-label">Let us feed your crew</span>
      <h2>Thanks for considering Brewhemia for your catering needs.</h2>
      <p>Three easy ways to get started:</p>
      <ol>
        <li>Place your order through <a href="https://www.ezcater.com/catering/pvt/brewhemia-3" target="_blank" rel="noopener">ezCater</a>.</li>
        <li>Text or call our catering manager, Andrea, at <a href="tel:3193893595">319.389.3595</a>.</li>
        <li>Fill out the form below and we'll get back to you.</li>
      </ol>
    </div>

    <form class="catering-form" id="catering-form" name="catering" method="POST" action="/api/catering">
      <div class="hp-field" aria-hidden="true">
        <label for="website_hp">Website</label>
        <input type="text" id="website_hp" name="website_hp" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="form_ts" id="catering-form-ts" value="" />
      <div class="form-row">
        <div class="form-group">
          <label for="name">Name <span class="required">*</span></label>
          <input type="text" id="name" name="name" required />
        </div>
        <div class="form-group">
          <label for="company">Company</label>
          <input type="text" id="company" name="company" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="phone">Phone <span class="required">*</span></label>
          <input type="tel" id="phone" name="phone" required />
        </div>
        <div class="form-group">
          <label for="email">Email <span class="required">*</span></label>
          <input type="email" id="email" name="email" required />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="event-date">Date of event</label>
          <input type="text" id="event-date" name="event-date" placeholder="MM/DD/YYYY" />
        </div>
        <div class="form-group">
          <label for="headcount">How many people?</label>
          <input type="number" id="headcount" name="headcount" min="1" />
        </div>
      </div>

      <div class="form-group">
        <label>Interested in</label>
        <div class="checkboxes">
          <label class="checkbox-label"><input type="checkbox" name="interested" value="Coffee" /> Coffee</label>
          <label class="checkbox-label"><input type="checkbox" name="interested" value="Donuts" /> Donuts</label>
          <label class="checkbox-label"><input type="checkbox" name="interested" value="Breakfast" /> Breakfast</label>
          <label class="checkbox-label"><input type="checkbox" name="interested" value="Lunch" /> Lunch</label>
          <label class="checkbox-label"><input type="checkbox" name="interested" value="Other" /> Other</label>
        </div>
      </div>

      <div class="form-group">
        <label for="details">Details <span class="required">*</span></label>
        <textarea id="details" name="details" rows="5" required></textarea>
      </div>

      <button type="submit" class="btn-submit">SEND CATERING REQUEST</button>
      <div class="cf-turnstile" data-sitekey="0x4AAAAAAFElAop_3ftSB6oF" data-theme="light" style="margin-top:1rem"></div>
      <p class="form-status" id="catering-status" role="status" aria-live="polite"></p>
    </form>
  </section>
</Base>

<style>
  .catering { max-width: var(--max-width); margin: var(--spacing-4xl) auto 0; padding: 0 var(--spacing-xl); }

  .catering-intro { margin-bottom: var(--spacing-2xl); }
  .catering-intro .mono-label { display: block; color: var(--color-burnt-orange); margin-bottom: var(--spacing-sm); }
  .catering-intro h2 { font-size: var(--font-size-2xl); margin-bottom: var(--spacing-md); }
  .catering-intro p { color: var(--color-espresso); margin-bottom: var(--spacing-sm); }
  .catering-intro ol { padding-left: 1.4rem; color: var(--color-espresso); line-height: 1.9; }
  .catering-intro ol a { color: var(--color-burnt-orange); border-bottom: 1px solid currentColor; }
  .catering-intro ol a:hover { color: var(--color-amber-ink); }

  .catering-form {
    background: var(--color-linen-beige);
    border: 1px solid var(--color-taupe-hairline);
    border-radius: var(--radius-lg);
    padding: var(--spacing-2xl);
  }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-lg); }
  .form-group { margin-bottom: var(--spacing-lg); }
  .form-group label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-espresso);
    margin-bottom: var(--spacing-xs);
  }
  .required { color: var(--color-burnt-orange); }
  .form-group input, .form-group textarea {
    width: 100%;
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-espresso);
    background: var(--color-cream-paper);
    border: 1px solid var(--color-taupe-hairline);
    border-radius: var(--radius);
    padding: 0.7rem 0.85rem;
  }
  .form-group input:focus, .form-group textarea:focus { outline: none; border-color: var(--color-burnt-orange); }

  .checkboxes { display: flex; flex-wrap: wrap; gap: var(--spacing-md); }
  .checkbox-label {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-body); font-size: var(--font-size-sm); text-transform: none; letter-spacing: 0;
    color: var(--color-espresso); margin-bottom: 0;
  }
  .checkbox-label input { width: auto; }

  .btn-submit {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--color-burnt-orange);
    color: var(--paper-fixed);
    border: none;
    border-radius: var(--radius);
    padding: 0.8rem 2rem;
    cursor: pointer;
    transition: background var(--transition-fast);
  }
  .btn-submit:hover { background: var(--color-amber-ink); }
  .btn-submit:disabled { opacity: 0.6; cursor: default; }
  .form-status { margin-top: var(--spacing-md); font-family: var(--font-mono); font-size: var(--font-size-sm); }
  .form-status.error { color: var(--color-burnt-orange); }
  .form-status.success { color: #2e7d32; }

  @media (max-width: 600px) {
    .form-row { grid-template-columns: 1fr; }
  }
  .hp-field { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
</style>

<script>
  const cform = document.getElementById("catering-form") as HTMLFormElement | null;
  const cstatus = document.getElementById("catering-status");
  const ctsField = document.getElementById("catering-form-ts") as HTMLInputElement | null;
  if (ctsField) ctsField.value = String(Date.now());
  if (cform && cstatus) {
    cform.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = cform.querySelector("button[type=submit]") as HTMLButtonElement;
      cstatus.className = "form-status";
      cstatus.textContent = "";
      btn.disabled = true;
      btn.textContent = "SENDING…";
      const cfd = new FormData(cform);
      if (!cfd.get("cf-turnstile-response")) {
        cstatus.className = "form-status error";
        cstatus.textContent = "Please complete the anti-spam check above.";
        btn.disabled = false;
        btn.textContent = "SEND CATERING REQUEST";
        return;
      }
      try {
        const res = await fetch("/api/catering", {
          method: "POST",
          body: cfd,
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          cform.reset();
          cstatus.className = "form-status success";
          cstatus.textContent = "Thanks for reaching out — we'll be in touch soon!";
        } else {
          cstatus.className = "form-status error";
          cstatus.textContent = data.error || "Something went wrong. Please try again.";
        }
      } catch {
        cstatus.className = "form-status error";
        cstatus.textContent = "Network error. Please try again.";
      } finally {
        btn.disabled = false;
        btn.textContent = "SEND CATERING REQUEST";
        if ((window as any).turnstile) (window as any).turnstile.reset();
      }
    });
  }
</script>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
