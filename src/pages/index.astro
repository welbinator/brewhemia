---
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/base";

const features = [
  {
    href: "/menu",
    img: "/images/grilled-cheese-and-soup.webp",
    kicker: "Kitchen",
    title: "Breakfast & Lunch",
    body: "Award-winning breakfast burritos — a Food Network Top 25 — biscuits & gravy, and our Parmesan-encrusted grilled cheese. Made from scratch, every day.",
  },
  {
    href: "/menu",
    img: "/images/bottles-dark.webp",
    kicker: "Bar",
    title: "Coffee to Cocktails",
    body: "Espresso, cold brew and The Bohemian by day; Iowa craft beer, wine, local spirits and a seriously handcrafted Irish coffee whenever the mood strikes.",
  },
  {
    href: "/events",
    img: "/images/vinyl-night3.webp",
    kicker: "Community",
    title: "In New Bohemia",
    body: "Rotating art on the walls, vinyl on the turntable, and a room built for lingering. A small-town feel that vibes like a big-city café.",
  },
];

// Real Google / Yelp reviews — verbatim, sourced Sep 2026
const reviews = [
  {
    quote: "What's not to love? The atmosphere is chill, the food is delicious, and the service is great. My favorites are the breakfast burrito in the morning, and the curry chicken salad for lunch.",
    name: "Rachel K.",
    meta: "Yelp Elite",
  },
  {
    quote: "Nice and cozy little coffee house, that also serves breakfast, lunch and beer to boot! The food was delicious, the coffee excellent. New favorite coffee spot!",
    name: "Ryan B.",
    meta: "Google review",
  },
  {
    quote: "We came to Brewhemia for a late breakfast and this place is clearly beloved in this area! Good quality coffee, nice ambiance inside, and good service staff.",
    name: "Trevor H.",
    meta: "Google review",
  },
  {
    quote: "While visiting friends, we stopped here for coffee. The staff were friendly and attentive. The place was clean and offers a comfortable atmosphere.",
    name: "David K.",
    meta: "Google review",
  },
  {
    quote: "A surprising vegan hot spot! I stopped by Brewhemia for a friend's bachelorette day. As a former Midwesterner, I wasn't expecting much in the way of vegan options.",
    name: "Kelly P.",
    meta: "Yelp review",
  },
];
---

<Base
  title="Coffee | Espresso | Beer | Wine | Spirits | Food"
  description="Brewhemia is a family-owned café & bar in Cedar Rapids' New Bohemia (NewBo) District — coffee, espresso, scratch-made breakfast & lunch, beer, wine and spirits. Open Tue–Sun, 8am–2pm.">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-media">
      <img src={withBase("/images/brewhemia-hero.webp")} srcset={`${withBase("/images/brewhemia-hero-800.webp")} 800w, ${withBase("/images/brewhemia-hero.webp")} 1500w`} sizes="100vw" width="1500" height="633" alt="Inside Brewhemia café — espresso bar, exposed brick, morning light" loading="eager" fetchpriority="high" decoding="async" />
    </div>
    <div class="hero-scrim"></div>
    <div class="hero-panel">
      <span class="hero-kicker reveal">Est. New Bohemia · Cedar Rapids, IA</span>
      <h1 class="reveal">A family-owned café<br />on 3rd Street.</h1>
      <p class="reveal">Amazing coffee, scratch-made breakfast & lunch, and a full bar — served inside the historic ZCBJ Hall since day one.</p>
      <div class="hero-actions reveal">
        <a href="https://order.toasttab.com/online/brewhemia-1202-3rd-st-se-ste-101" target="_blank" rel="noopener noreferrer" class="btn-primary">ORDER ONLINE</a>
        <a href={withBase("/menu")} class="btn-ghost">SEE THE MENU</a>
      </div>
      <div class="hero-rating reveal">
        <span class="stars">★★★★★</span>
        <span class="rating-text">4.7 · 746 Google reviews</span>
      </div>
    </div>
    <a href="#intro" class="hero-scroll" aria-label="Scroll to content"><span></span></a>
  </section>

  <!-- TAGLINE STRIP -->
  <div class="tagline-strip">
    <span>COFFEE</span><b>·</b><span>ESPRESSO</span><b>·</b><span>BEER</span><b>·</b><span>WINE</span><b>·</b><span>SPIRITS</span><b>·</b><span>FOOD</span>
  </div>

  <!-- INTRO -->
  <section class="intro" id="intro">
    <div class="intro-inner">
      <span class="mono-label reveal">Open · Tue–Sun · 8am–2pm</span>
      <h2 class="reveal">We took the best of an American café and gave it a European twist.</h2>
      <p class="reveal">Brewhemia is a name that encompasses a focus on quality beverage while embracing the community and neighborhood of New Bohemia. Come for the coffee, stay for the biscuits and gravy, come back for a glass of wine.</p>
      <a href={withBase("/about-us")} class="text-link reveal">Read our story →</a>
    </div>
  </section>

  <!-- FEATURE CARDS -->
  <section class="features">
    <div class="features-grid">
      {features.map((f) => (
        <a href={withBase(f.href)} class="feature-card reveal">
          <div class="feature-img"><img src={withBase(f.img)} alt={f.title} loading="lazy" /></div>
          <div class="feature-body">
            <span class="feature-kicker">{f.kicker}</span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
            <span class="feature-more">Explore →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="reviews">
    <div class="reviews-head">
      <span class="mono-label reveal">From the neighborhood</span>
      <h2 class="reveal">Beloved in Cedar Rapids.</h2>
    </div>
    <div class="reviews-carousel reveal" data-review-carousel>
      <button class="rc-arrow rc-prev" data-rc-prev aria-label="Previous review">‹</button>
      <div class="rc-stage">
        {reviews.map((r, i) => (
          <figure class="review-card" data-rc-card data-index={i}>
            <div class="review-stars">★★★★★</div>
            <blockquote>{r.quote}</blockquote>
            <figcaption><span class="review-name">{r.name}</span><span class="review-meta">{r.meta}</span></figcaption>
          </figure>
        ))}
      </div>
      <button class="rc-arrow rc-next" data-rc-next aria-label="Next review">›</button>
      <div class="rc-dots" data-rc-dots>
        {reviews.map((_, i) => (
          <button class="rc-dot" data-rc-dot data-index={i} aria-label={`Go to review ${i + 1}`}></button>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="cta-band">
    <div class="cta-inner">
      <h2 class="reveal">Pull up a stool.</h2>
      <p class="reveal">1202 3rd St SE · Cedar Rapids, IA 52401 — open Tuesday through Sunday, 8am to 2pm.</p>
      <div class="cta-actions reveal">
        <a href="https://order.toasttab.com/online/brewhemia-1202-3rd-st-se-ste-101" target="_blank" rel="noopener noreferrer" class="btn-primary">ORDER ONLINE</a>
        <a href="https://maps.google.com/?q=1202+3rd+St+SE+Cedar+Rapids+Iowa+52401" target="_blank" rel="noopener noreferrer" class="btn-ghost light">GET DIRECTIONS</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var root = document.querySelector("[data-review-carousel]");
      if (!root) return;
      var cards = Array.prototype.slice.call(root.querySelectorAll("[data-rc-card]"));
      var dots = Array.prototype.slice.call(root.querySelectorAll("[data-rc-dot]"));
      var prev = root.querySelector("[data-rc-prev]");
      var next = root.querySelector("[data-rc-next]");
      var n = cards.length;
      if (!n) return;
      var current = Math.floor(n / 2); // start with a middle review featured
      var timer = null;
      var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function render() {
        cards.forEach(function (card, i) {
          var pos;
          if (i === current) pos = "center";
          else if (i === (current - 1 + n) % n) pos = "left";
          else if (i === (current + 1) % n) pos = "right";
          else {
            // park remaining cards off to whichever side is shorter, so they slide in/out
            var forward = (i - current + n) % n;   // steps to reach going right
            var backward = (current - i + n) % n;  // steps to reach going left
            pos = forward <= backward ? "far-right" : "far-left";
          }
          card.setAttribute("data-pos", pos);
        });
        dots.forEach(function (d, i) { d.classList.toggle("is-active", i === current); });
      }
      function go(i) { current = (i + n) % n; render(); }
      function start() {
        if (reduce || timer) return;
        timer = setInterval(function () { go(current + 1); }, 5000);
      }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function restart() { stop(); start(); }

      next.addEventListener("click", function () { go(current + 1); restart(); });
      prev.addEventListener("click", function () { go(current - 1); restart(); });
      dots.forEach(function (d, i) { d.addEventListener("click", function () { go(i); restart(); }); });
      root.addEventListener("mouseenter", stop);
      root.addEventListener("mouseleave", start);

      render();
      start();
    })();
  </script>
</Base>

<style>
  /* ---------- HERO (full-screen) ---------- */
  .hero {
    position: relative;
    min-height: calc(100vh - 64px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: var(--spacing-4xl) var(--spacing-xl);
    overflow: hidden;
    isolation: isolate;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    border: none;
    border-radius: 0;
    overflow: hidden;
  }
  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: heroZoom 18s ease-out forwards;
  }
  @keyframes heroZoom {
    from { transform: scale(1.08); }
    to   { transform: scale(1); }
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* uniform dark wash + a stronger vignette at top & bottom for depth */
    background:
      linear-gradient(to bottom, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.4) 30%, rgba(0,0,0,0.4) 70%, rgba(0,0,0,0.66) 100%),
      rgba(0,0,0,0.35);
  }
  .hero-panel {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 760px;
    width: 100%;
    margin: 0 auto;
    padding: 0;
    color: #fff;
  }
  .hero-kicker {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.9);
    margin-bottom: var(--spacing-lg);
  }
  .hero-panel h1 {
    font-size: clamp(2.8rem, 6.5vw, 5rem);
    line-height: 1.04;
    margin-bottom: var(--spacing-xl);
    color: #fff;
    text-shadow: 0 2px 30px rgba(0,0,0,0.45);
  }
  .hero-panel > p {
    font-size: var(--font-size-lg);
    color: rgba(255,255,255,0.94);
    max-width: 52ch;
    margin: 0 auto var(--spacing-2xl);
    line-height: 1.6;
    text-shadow: 0 1px 14px rgba(0,0,0,0.5);
  }
  .hero-actions { display: flex; gap: var(--spacing-md); flex-wrap: wrap; justify-content: center; margin-bottom: var(--spacing-xl); }
  .hero-rating { display: flex; align-items: center; justify-content: center; gap: var(--spacing-sm); }
  .stars, .review-stars, .review-card .review-stars { color: var(--color-amber-ink); letter-spacing: 0.1em; }
  .rating-text {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.06em;
    color: rgba(255,255,255,0.82);
  }
  /* scroll cue */
  .hero-scroll {
    position: absolute;
    bottom: var(--spacing-lg);
    left: 50%;
    transform: translateX(-50%);
    width: 26px;
    height: 42px;
    border: 2px solid rgba(255,255,255,0.7);
    border-radius: 14px;
    display: flex;
    justify-content: center;
    padding-top: 7px;
    z-index: 2;
  }
  .hero-scroll span {
    width: 4px;
    height: 8px;
    background: #fff;
    border-radius: 2px;
    animation: scrollCue 1.6s ease-in-out infinite;
  }
  @keyframes scrollCue {
    0%   { opacity: 0; transform: translateY(-4px); }
    40%  { opacity: 1; }
    80%  { opacity: 0; transform: translateY(10px); }
    100% { opacity: 0; }
  }

  /* ---------- BUTTONS ---------- */
  .btn-primary, .btn-ghost {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.7rem 1.4rem;
    border-radius: var(--radius);
    transition: all var(--transition-fast);
  }
  .btn-primary { background: var(--color-brand-red); color: var(--paper-fixed); }
  .btn-primary:hover { background: var(--color-amber-ink); }
  .btn-ghost { border: 1px solid var(--color-espresso); color: var(--color-espresso); }
  .btn-ghost:hover { background: var(--color-espresso); color: var(--color-cream-paper); }
  .btn-ghost.light { border-color: var(--paper-fixed); color: var(--paper-fixed); }
  .btn-ghost.light:hover { background: var(--paper-fixed); color: var(--ink-fixed); }

  /* Hero buttons always sit on the dark image overlay — keep them white in BOTH themes */
  .hero-actions .btn-ghost {
    border-color: var(--paper-fixed);
    color: var(--paper-fixed);
    background: transparent;
  }
  .hero-actions .btn-ghost:hover {
    background: var(--paper-fixed);
    color: var(--ink-fixed);
  }
  .hero-actions .btn-primary {
    background: var(--color-brand-red);
    color: var(--paper-fixed);
  }
  .hero-actions .btn-primary:hover { background: var(--color-amber-ink); }

  /* ---------- TAGLINE STRIP ---------- */
  .tagline-strip {
    background: var(--ink-fixed);
    color: var(--color-marigold-wash);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    letter-spacing: 0.18em;
    text-align: center;
    padding: var(--spacing-md);
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }
  .tagline-strip b { color: var(--color-brand-red); }

  /* ---------- INTRO ---------- */
  .intro {
    max-width: var(--max-width);
    margin: var(--spacing-5xl) auto;
    padding: 0 var(--spacing-xl);
    text-align: center;
  }
  .intro .mono-label { display: block; margin-bottom: var(--spacing-md); color: var(--color-brand-red); }
  .intro h2 { font-size: var(--font-size-3xl); margin-bottom: var(--spacing-lg); }
  .intro p { font-size: var(--font-size-lg); color: var(--color-espresso); margin-bottom: var(--spacing-lg); }
  .text-link {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    letter-spacing: 0.06em;
    color: var(--color-brand-red);
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  /* ---------- FEATURES ---------- */
  .features { max-width: var(--wide-width); margin: 0 auto; padding: 0 var(--spacing-xl); }
  .features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-lg); }
  .feature-card {
    background: var(--color-linen-beige);
    border: 1px solid var(--color-taupe-hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast);
  }
  .feature-card:hover { transform: translateY(-3px); }
  .feature-img { aspect-ratio: 4 / 3; overflow: hidden; }
  .feature-img img { width: 100%; height: 100%; object-fit: cover; }
  .feature-body { padding: var(--spacing-lg); display: flex; flex-direction: column; gap: var(--spacing-sm); }
  .feature-kicker {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-coffee-dust);
  }
  .feature-body h3 { font-size: var(--font-size-xl); }
  .feature-body p { font-size: var(--font-size-sm); color: var(--color-espresso); line-height: 1.6; }
  .feature-more {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-top: auto;
  }

  /* ---------- REVIEWS ---------- */
  .reviews { max-width: var(--wide-width); margin: var(--spacing-5xl) auto 0; padding: 0 var(--spacing-xl); }
  .reviews-head { text-align: center; margin-bottom: var(--spacing-2xl); }
  .reviews-head .mono-label { display: block; margin-bottom: var(--spacing-sm); color: var(--color-brand-red); }
  .reviews-head h2 { font-size: var(--font-size-3xl); }

  /* ---- Reviews coverflow carousel ---- */
  .reviews-carousel { position: relative; }
  .rc-stage {
    position: relative;
    height: 340px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .review-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(440px, 82vw);
    background: var(--color-cream-paper);
    border: 1px solid var(--color-taupe-hairline);
    border-radius: var(--radius-lg);
    padding: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.6s ease, filter 0.6s ease;
    will-change: transform, opacity;
  }
  /* stacking positions set via data-pos — hidden cards park OFF to the sides so motion slides */
  .review-card[data-pos="center"]      { transform: translate(-50%, -50%) scale(1);    opacity: 1;    z-index: 3; filter: none; }
  .review-card[data-pos="left"]        { transform: translate(-118%, -50%) scale(0.8); opacity: 0.5; z-index: 2; filter: brightness(0.85); }
  .review-card[data-pos="right"]       { transform: translate(18%, -50%) scale(0.8);   opacity: 0.5; z-index: 2; filter: brightness(0.85); }
  .review-card[data-pos="far-left"]    { transform: translate(-190%, -50%) scale(0.65); opacity: 0; z-index: 1; pointer-events: none; }
  .review-card[data-pos="far-right"]   { transform: translate(90%, -50%) scale(0.65);   opacity: 0; z-index: 1; pointer-events: none; }
  .review-card .review-stars { font-size: var(--font-size-sm); }
  .review-card blockquote {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.4;
    color: var(--color-espresso);
    letter-spacing: -0.01em;
  }
  .review-card[data-pos="center"] blockquote { font-size: 1.32rem; }
  .review-card figcaption { display: flex; flex-direction: column; margin-top: auto; }
  .review-name { font-weight: 600; font-size: var(--font-size-sm); color: var(--color-espresso); }
  .review-meta {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.04em;
    color: var(--color-coffee-dust);
  }
  .rc-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--color-taupe-hairline);
    background: var(--color-cream-paper);
    color: var(--color-espresso);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .rc-arrow:hover { background: var(--color-brand-red); color: #fff; border-color: var(--color-brand-red); }
  .rc-prev { left: 0; }
  .rc-next { right: 0; }
  .rc-dots { display: flex; justify-content: center; gap: 8px; margin-top: var(--spacing-xl); }
  .rc-dot {
    width: 9px; height: 9px; border-radius: 50%;
    border: none; padding: 0; cursor: pointer;
    background: var(--color-taupe-hairline);
    transition: background 0.25s, transform 0.25s;
  }
  .rc-dot.is-active { background: var(--color-brand-red); transform: scale(1.25); }

  /* ---------- CTA BAND ---------- */
  .cta-band { margin-top: var(--spacing-5xl); background: var(--color-linen-beige); border-top: 1px solid var(--color-taupe-hairline); border-bottom: 1px solid var(--color-taupe-hairline); }
  .cta-inner { max-width: var(--max-width); margin: 0 auto; padding: var(--spacing-4xl) var(--spacing-xl); text-align: center; }
  .cta-inner h2 { font-size: var(--font-size-3xl); margin-bottom: var(--spacing-md); }
  .cta-inner p { color: var(--color-espresso); font-size: var(--font-size-lg); margin-bottom: var(--spacing-xl); }
  .cta-actions { display: flex; gap: var(--spacing-md); justify-content: center; flex-wrap: wrap; }
  .cta-band .btn-ghost { border-color: var(--color-espresso); color: var(--color-espresso); }
  .cta-band .btn-ghost:hover { background: var(--color-espresso); color: var(--color-cream-paper); }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 900px) {
    .hero { min-height: calc(100svh - 64px); padding-bottom: var(--spacing-3xl); }
    .hero-panel h1 { font-size: clamp(2.2rem, 9vw, 3rem); }
    .features-grid { grid-template-columns: 1fr; }
    /* Carousel: show only the centered card on small screens */
    .rc-stage { height: 400px; }
    .review-card[data-pos="left"], .review-card[data-pos="right"],
    .review-card[data-pos="far-left"], .review-card[data-pos="far-right"] { opacity: 0; pointer-events: none; }
    .review-card[data-pos="left"] { transform: translate(-160%, -50%) scale(0.8); }
    .review-card[data-pos="right"] { transform: translate(60%, -50%) scale(0.8); }
    .review-card { width: min(440px, 88vw); }
    .rc-arrow { width: 38px; height: 38px; font-size: 1.4rem; }
  }
</style>
