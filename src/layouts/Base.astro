---
import "../styles/tokens.css";
import "../styles/theme.css";
import { withBase } from "../lib/base";
import StagingReviewBar from "../components/StagingReviewBar.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** If true, renders a full-width page banner (inner pages) */
  bannerTitle?: string;
  bannerImage?: string;
  bannerKicker?: string;
}

const { title, description, image, bannerTitle, bannerImage, bannerKicker } = Astro.props;
const siteTitle = "BREWHEMIA";
const fullTitle = title ? `${title} – ${siteTitle}` : siteTitle;
const siteDescription =
  description || "Coffee | Espresso | Beer | Wine | Spirits | Food";

const currentPath = Astro.url.pathname;
const isStaging = Astro.url.hostname.includes("staging") || Astro.url.hostname.endsWith(".workers.dev");

// LocalBusiness structured data (production only). Powers Google local/knowledge-panel results.
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "CafeOrCoffeeShop",
  "@id": "https://brewhemia.com/#business",
  name: "Brewhemia",
  description:
    "Family-owned café and bar in the historic ZCBJ Hall, New Bohemia District, Cedar Rapids — coffee, espresso, scratch-made breakfast & lunch, beer, wine and spirits.",
  url: "https://brewhemia.com",
  telephone: "+1-319-364-0802",
  email: "info@brewhemia.com",
  image: "https://brewhemia.com/images/brewhemia-hero.webp",
  priceRange: "$$",
  servesCuisine: ["Coffee", "Breakfast", "Lunch", "American"],
  address: {
    "@type": "PostalAddress",
    streetAddress: "1202 3rd St SE",
    addressLocality: "Cedar Rapids",
    addressRegion: "IA",
    postalCode: "52401",
    addressCountry: "US",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 41.9702617,
    longitude: -91.6577068,
  },
  hasMap: "https://maps.google.com/?q=1202+3rd+St+SE+Cedar+Rapids+Iowa+52401",
  sameAs: ["https://www.facebook.com/brewhemia"],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday",
      ],
      opens: "08:00",
      closes: "14:00",
    },
  ],
  acceptsReservations: false,
  menu: "https://brewhemia.com/menu/",
};

const isHome = currentPath === "/" || currentPath === "";
// Staging build = GitHub Pages project mount (base != "/"). Only then ship the review bar.
const isStagingBuild = Boolean(import.meta.env.BASE_URL && import.meta.env.BASE_URL !== "/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // No-flash theme init: read saved choice or fall back to OS preference,
      // set data-theme BEFORE first paint so there's no light->dark flicker.
      (function () {
        try {
          var saved = localStorage.getItem("bh-theme");
          var theme = saved || (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={Astro.url.href} />
    <!-- Fonts: preconnect + non-blocking load (was a render-blocking @import) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inclusive+Sans:ital,wght@0,400;0,500;0,600;0,700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inclusive+Sans:ital,wght@0,400;0,500;0,600;0,700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      />
    </noscript>
    {isHome && <link rel="preload" as="image" href={withBase("/images/brewhemia-hero-800.webp")} imagesrcset={`${withBase("/images/brewhemia-hero-800.webp")} 800w, ${withBase("/images/brewhemia-hero.webp")} 1500w`} imagesizes="100vw" fetchpriority="high" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    {image && <meta property="og:image" content={image} />}
    {isStaging && <meta name="robots" content="noindex, nofollow" />}
    {!isStagingBuild && (
      <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    )}
    {!isStaging && (
      <>
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-4RTGLSYH4J"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-4RTGLSYH4J');
        </script>
      </>
    )}
  </head>
  <body>
    <!-- HEADER -->
    <header class="site-header">
      <div class="header-inner">
        <a href={withBase("/")} class="site-logo">brewhemia<span class="logo-dot">.</span></a>

        <!-- Hamburger (mobile only) -->
        <button type="button" class="nav-toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="primary-nav">
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </button>

        <nav class="primary-nav" id="primary-nav">
          <ul>
            <li><a href={withBase("/about-us")} class:list={[{ active: currentPath.startsWith('/about-us') }]}>ABOUT</a></li>
            <li><a href={withBase("/menu")} class:list={[{ active: currentPath.startsWith('/menu') }]}>MENU</a></li>
            <li><a href={withBase("/catering")} class:list={[{ active: currentPath.startsWith('/catering') }]}>CATERING</a></li>
            <li><a href={withBase("/events")} class:list={[{ active: currentPath.startsWith('/events') }]}>EVENTS</a></li>
            <li><a href={withBase("/contact-us")} class:list={[{ active: currentPath.startsWith('/contact-us') }]}>CONTACT</a></li>
            <li><a href="https://order.toasttab.com/online/brewhemia-1202-3rd-st-se-ste-101" target="_blank" rel="noopener noreferrer" class="btn-order">ORDER ONLINE</a></li>
            <!-- Theme toggle inside the mobile menu -->
            <li class="nav-theme-item">
              <button type="button" class="theme-toggle theme-toggle--menu" data-theme-toggle aria-label="Toggle light and dark mode">
                <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
                <span class="theme-toggle-label">Light / dark mode</span>
              </button>
            </li>
          </ul>
        </nav>

        <!-- Theme toggle in header (desktop only) -->
        <button
          type="button"
          class="theme-toggle theme-toggle--header"
          data-theme-toggle
          aria-label="Toggle light and dark mode"
          title="Toggle light / dark mode"
        >
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
        </button>
      </div>
    </header>

    <!-- INNER PAGE BANNER (shown on non-home pages) -->
    {bannerTitle && (
      <div class="page-banner">
        {bannerImage && (
          <div class="page-banner-media" style={`background-image: url('${withBase(bannerImage)}')`}></div>
        )}
        <div class="page-banner-inner">
          {bannerKicker && <span class="banner-kicker">{bannerKicker}</span>}
          <h1>{bannerTitle}</h1>
        </div>
      </div>
    )}

    <!-- MAIN CONTENT -->
    <main>
      <slot />
    </main>

    {isStagingBuild && <StagingReviewBar />}

    <!-- FOOTER -->
    <footer class="site-footer">
      <div class="footer-content">
        <div class="footer-col footer-brand">
          <span class="footer-wordmark">brewhemia<span class="logo-dot">.</span></span>
          <p class="footer-blurb">A family-owned café in the historic ZCBJ Hall, New Bohemia District, Cedar Rapids.</p>
          <span class="footer-tag">COFFEE · ESPRESSO · BEER · WINE · SPIRITS · FOOD</span>
        </div>
        <div class="footer-col">
          <h3>Hours</h3>
          <div class="hours-row"><span>Monday</span><span>Closed</span></div>
          <div class="hours-row"><span>Tue–Sun</span><span>8am – 2pm</span></div>
        </div>
        <div class="footer-col">
          <h3>Connect</h3>
          <p><a href="https://www.facebook.com/brewhemia" target="_blank" rel="noopener">Facebook</a></p>
          <p><a href="mailto:info@brewhemia.com">info@brewhemia.com</a></p>
          <p><a href="tel:3193640802">(319) 364–0802</a></p>
        </div>
        <div class="footer-col">
          <h3>Address</h3>
          <p>1202 3rd St SE</p>
          <p>Cedar Rapids, IA 52401</p>
          <p><a href="https://maps.google.com/?q=1202+3rd+St+SE+Cedar+Rapids+Iowa+52401" target="_blank" rel="noopener">Get Directions →</a></p>
        </div>
      </div>
      <div class="footer-ctas">
        <a href="https://order.toasttab.com/online/brewhemia-1202-3rd-st-se-ste-101" target="_blank" rel="noopener noreferrer" class="btn-footer">ORDER ONLINE</a>
        <a href="https://order.toasttab.com/egiftcards/brewhemia-1202-3rd-st-se-ste-101" target="_blank" rel="noopener noreferrer" class="btn-footer ghost">BUY GIFT CARDS</a>
      </div>
      <div class="footer-bottom">
        <p>© 2019 BREWHEMIA · All Rights Reserved</p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        // ---- Theme toggle (both header + in-menu buttons) ----
        var toggles = document.querySelectorAll("[data-theme-toggle]");
        requestAnimationFrame(function () {
          document.documentElement.classList.add("theme-ready");
        });
        toggles.forEach(function (btn) {
          btn.addEventListener("click", function () {
            var cur = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
            var next = cur === "dark" ? "light" : "dark";
            document.documentElement.setAttribute("data-theme", next);
            try { localStorage.setItem("bh-theme", next); } catch (e) {}
          });
        });

        // ---- Mobile hamburger menu ----
        var navToggle = document.getElementById("nav-toggle");
        var nav = document.getElementById("primary-nav");
        if (navToggle && nav) {
          function setOpen(open) {
            nav.classList.toggle("is-open", open);
            navToggle.classList.toggle("is-active", open);
            navToggle.setAttribute("aria-expanded", open ? "true" : "false");
            navToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
            document.body.classList.toggle("nav-open", open);
          }
          navToggle.addEventListener("click", function () {
            setOpen(!nav.classList.contains("is-open"));
          });
          // Close when a nav link is tapped (but not the theme toggle)
          nav.querySelectorAll("a").forEach(function (a) {
            a.addEventListener("click", function () { setOpen(false); });
          });
          // Close on Escape
          document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") setOpen(false);
          });
          // Reset when resizing up to desktop
          window.addEventListener("resize", function () {
            if (window.innerWidth > 768) setOpen(false);
          });
        }

        // ---- Scroll reveal animations (sitewide) ----
        var prefersReduced = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var revealEls = document.querySelectorAll(".reveal");
        if (prefersReduced || !("IntersectionObserver" in window)) {
          revealEls.forEach(function (el) { el.classList.add("is-visible"); });
        } else {
          // Stagger siblings that share a parent for a gentle cascade.
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                var el = entry.target;
                var sibs = el.parentElement ? Array.prototype.slice.call(el.parentElement.querySelectorAll(":scope > .reveal")) : [el];
                var idx = sibs.indexOf(el);
                el.style.transitionDelay = (idx > 0 ? Math.min(idx, 6) * 80 : 0) + "ms";
                el.classList.add("is-visible");
                io.unobserve(el);
              }
            });
          }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
          revealEls.forEach(function (el) { io.observe(el); });
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  @layer base;

  /* ---- Scroll reveal (sitewide, tasteful) ---- */
  .reveal {
    opacity: 0;
    transform: translateY(22px);
    will-change: opacity, transform;
  }
  .reveal.is-visible {
    opacity: 1;
    transform: none;
  }
  html.theme-ready .reveal {
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
    .hero-media img { animation: none !important; }
    .hero-scroll span { animation: none !important; }
  }

  @layer base {
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--font-body);
      font-size: var(--font-size-base);
      line-height: var(--leading-normal);
      letter-spacing: 0.01em;
      color: var(--color-espresso);
      background: var(--color-cream-paper);
      -webkit-font-smoothing: antialiased;
    }

    a { text-decoration: none; color: inherit; }

    img { max-width: 100%; height: auto; display: block; }

    h1, h2, h3, h4 {
      font-family: var(--font-display);
      font-weight: 400;
      line-height: var(--leading-snug);
      letter-spacing: var(--tracking-tight);
      color: var(--color-espresso);
    }

    /* Mono label utility */
    .mono-label {
      font-family: var(--font-mono);
      font-size: var(--font-size-xs);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-coffee-dust);
    }
  }
</style>

<style>
  /* ============================ HEADER ============================ */
  .site-header {
    background: var(--color-cream-paper);
    border-bottom: 1px solid var(--color-taupe-hairline);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: 0 var(--spacing-xl);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-lg);
    height: 72px;
  }
  .primary-nav { margin-left: auto; }

  /* Hamburger button — hidden on desktop, shown < 768px */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 0 9px;
    background: transparent;
    border: 1px solid var(--color-taupe-hairline);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .nav-toggle-bar {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-espresso);
    border-radius: 2px;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }
  .nav-toggle.is-active .nav-toggle-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle.is-active .nav-toggle-bar:nth-child(2) { opacity: 0; }
  .nav-toggle.is-active .nav-toggle-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* In-menu theme toggle row — hidden on desktop (desktop uses header button) */
  .nav-theme-item { display: none; }
  .theme-toggle-label { display: none; }

  .site-logo {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--color-espresso);
    letter-spacing: -0.02em;
  }
  .logo-dot { color: var(--color-brand-red); }

  .primary-nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--spacing-xl);
  }

  .primary-nav a {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-espresso);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color var(--transition-fast);
  }

  .primary-nav a:hover { color: var(--color-brand-red); }
  .primary-nav a.active { color: var(--color-brand-red); }

  .btn-order {
    background: var(--color-brand-red) !important;
    color: var(--paper-fixed) !important;
    padding: 0.55rem 1rem;
    border-radius: var(--radius);
    transition: background var(--transition-fast) !important;
  }
  .btn-order:hover { background: var(--color-amber-ink) !important; }

  /* ============================ PAGE BANNER ============================ */
  .page-banner {
    position: relative;
    background: var(--color-linen-beige);
    border-bottom: 1px solid var(--color-taupe-hairline);
    overflow: hidden;
  }
  .page-banner-media {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.28;
    filter: saturate(0.85);
  }
  .page-banner-inner {
    position: relative;
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: var(--spacing-4xl) var(--spacing-xl);
    text-align: left;
  }
  .banner-kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: var(--spacing-sm);
  }
  .page-banner h1 {
    font-size: var(--font-size-4xl);
    color: var(--color-espresso);
  }

  /* ============================ FOOTER ============================ */
  .site-footer {
    background: var(--color-footer-bg);
    color: var(--color-footer-text);
    padding-top: var(--spacing-4xl);
    margin-top: var(--spacing-5xl);
  }

  .footer-content {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: 0 var(--spacing-xl) var(--spacing-3xl);
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: var(--spacing-2xl);
  }

  .footer-wordmark {
    font-family: var(--font-display);
    font-size: 1.75rem;
    color: var(--paper-fixed);
  }
  .footer-blurb {
    margin: var(--spacing-md) 0;
    font-size: var(--font-size-sm);
    line-height: 1.6;
    max-width: 34ch;
    color: #e7d8cf;
  }
  .footer-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    color: var(--color-marigold-wash);
  }

  .footer-col h3 {
    font-family: var(--font-mono);
    color: var(--color-marigold-wash);
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: var(--spacing-md);
  }

  .footer-col p {
    font-size: var(--font-size-sm);
    margin-bottom: var(--spacing-xs);
    color: var(--color-footer-text);
  }
  .footer-col a { color: var(--color-footer-text); transition: color var(--transition-fast); }
  .footer-col a:hover { color: var(--color-marigold-wash); }

  .hours-row {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.04em;
    margin-bottom: var(--spacing-xs);
    color: var(--color-footer-text);
    border-bottom: 1px dotted rgba(231,216,207,0.2);
    padding-bottom: 3px;
  }

  .footer-ctas {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
    padding: var(--spacing-xl) var(--spacing-lg);
    flex-wrap: wrap;
  }

  .btn-footer {
    display: inline-block;
    background: var(--color-brand-red);
    color: var(--paper-fixed);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.7rem 2rem;
    border-radius: var(--radius);
    transition: all var(--transition-fast);
  }
  .btn-footer:hover { background: var(--color-amber-ink); }
  .btn-footer.ghost {
    background: transparent;
    border: 1px solid var(--color-coffee-dust);
    color: var(--paper-fixed);
  }
  .btn-footer.ghost:hover { border-color: var(--color-marigold-wash); color: var(--color-marigold-wash); }

  .footer-bottom {
    border-top: 1px solid rgba(231,216,207,0.15);
    padding: var(--spacing-lg);
    text-align: center;
  }
  .footer-bottom p {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: #b79c92;
  }

  /* ============================ RESPONSIVE ============================ */
  @media (max-width: 900px) {
    .footer-content { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 768px) {
    .header-inner {
      height: 64px;
      padding: 0 var(--spacing-lg);
      gap: var(--spacing-md);
    }

    /* Show hamburger, hide the desktop header toggle */
    .nav-toggle { display: flex; }
    .theme-toggle--header { display: none; }

